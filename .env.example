# Copiar a .env.local y completar. .env.local NO se versiona.

# Supabase (Project Settings > API Keys)
# URL base del proyecto, SIN /rest/v1/ al final.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (antes "anon key", empieza con sb_publishable_). Es pública: puede ir al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (antes "service_role key", empieza con sb_secret_). SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# WhatsApp Business Cloud API (Meta). Solo servidor.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
# WhatsApp del administrador que recibe avisos de pedidos nuevos (10 digitos, ej. 3513445566)
ADMIN_WHATSAPP=

# Solo si se despliega en varias instancias (clave estable para Server Actions)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Token personal de Supabase (Account > Access Tokens). Solo para scripts/apply-sql.mjs; no lo usa la app.
SUPABASE_ACCESS_TOKEN=
